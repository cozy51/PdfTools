{
  "manifest_version": 3,
  "name": "PDF 回転・削除・結合",
  "version": "1.4.0",
  "description": "専用タブでPDFとページの順番を調整し、ページの回転・複数選択削除・結合保存を行います。",
  "permissions": [
    "downloads"
  ],
  "action": {
    "default_title": "PDF Toolsを専用タブで開く"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
